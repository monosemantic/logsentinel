# n8n
# En local, laisser localhost
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678
N8N_LOG_LEVEL=info
CASCADE_THRESHOLD=3
CASCADE_WINDOW=60

# Cle de chiffrement n8n
# Generer avec : openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_hex_32

# Fuseau horaire
TIMEZONE=Africa/Casablanca

# PostgreSQL
POSTGRES_DB=logsentinel
POSTGRES_USER=n8n
# Mot de passe fort
# Generer avec : openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# Securite webhook HMAC-SHA256
# Les clients qui envoient des logs doivent signer leurs requetes avec ce secret
# Generer avec : openssl rand -hex 32
WEBHOOK_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# LLM Groq
# Creer un compte sur https://console.groq.com puis aller dans API Keys
# Modele recommande : llama-3.1-8b-instant ou llama-3.3-70b-versatile
GROQ_API_KEY=CHANGE_ME_gsk_xxxx
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# LLM fallback
# Laisser vide si vous n'avez pas de compte
# Le pipeline utilisera la reponse statique a la place
FALLBACK_API_KEY=
FALLBACK_MODEL=

# WhatsApp Twilio Sandbox
# Compte Twilio gratuit : https://www.twilio.com/try-twilio
# Sandbox WhatsApp : https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
# Activation du Sandbox
# 1. Aller sur la page Sandbox dans la console Twilio
# 2. Envoyer "join <mot-de-passe>" au numero Twilio depuis WhatsApp
# 3. Vous recevrez une confirmation, le sandbox sera actif pour votre numero
TWILIO_ACCOUNT_SID=CHANGE_ME_ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=CHANGE_ME_your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Votre numero WhatsApp avec indicatif pays
TWILIO_WHATSAPP_ADMIN=whatsapp:+212XXXXXXXXX
# Numero d'escalade, different de l'admin
TWILIO_WHATSAPP_ESCALATION=whatsapp:+212XXXXXXXXX

# SMTP
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM=votre-adresse@gmail.com
SMTP_TO=adresse-reception-alertes@gmail.com

# Google Sheets - Dashboard
# Configurer les credentials OAuth2 Google directement dans n8n
# Puis copier ici l'ID de la feuille depuis son URL
GOOGLE_SHEETS_ID=CHANGE_ME_your_spreadsheet_id

NGROK_AUTHTOKEN=