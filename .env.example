# POSTGRESQL

# Nom de la base de donnees (laisser tel quel sauf raison valable)
POSTGRES_DB=logsentinel

# Utilisateur PostgreSQL utilise par n8n et les scripts Python
POSTGRES_USER=n8n

# Mot de passe PostgreSQL
# Exemple : openssl rand -base64 32
POSTGRES_PASSWORD=changeme_mot_de_passe_fort


# N8N

# URL publique de n8n (utilisee pour construire les URLs de webhook)
# En local : http://localhost:5678
# Avec ngrok : https://abc123.ngrok.io  (mettre à jour à chaque session ngrok)
N8N_WEBHOOK_URL=http://localhost:5678

# Hostname n8n (garder localhost pour un setup local)
N8N_HOST=localhost

# Authentification basique de l'interface n8n
# Choisir un identifiant et mot de passe pour protéger l'accès
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_n8n_password


# SECURITE

# Secret partage pour la validation HMAC-SHA256 des requetes webhook
# Générer avec : openssl rand -hex 32
# Ce secret doit être le même côté client (celui qui envoie les logs)
WEBHOOK_SECRET=changeme_webhook_secret_hex


# OLLAMA
# URL interne d'Ollama (ne pas modifier si Docker Compose est utilise)
OLLAMA_BASE_URL=http://ollama:11434

# Modèle à utiliser — options recommandées :
#   llama3.1:8b   → bon équilibre vitesse/qualite (recommande)
#   mistral:7b    → plus rapide, qualite legerement inferieure
# Télécharger avec : docker exec logsentinel-ollama ollama pull llama3.1:8b
OLLAMA_MODEL=mistral:7b

# Timeout pour les appels Ollama en secondes (fallback declenche si dépasse)
OLLAMA_TIMEOUT_SECONDS=10


# LLM CLOUD (Fallback si Ollama indisponible)

# Fournisseur cloud de fallback : "anthropic" ou "openai"
LLM_CLOUD_PROVIDER=anthropic

# Clé API Anthropic (laisser vide si vous n'utilisez pas Anthropic)
# Obtenir sur : https://console.anthropic.com
ANTHROPIC_API_KEY=

# Clé API OpenAI (laisser vide si vous n'utilisez pas OpenAI)
# Obtenir sur : https://platform.openai.com
OPENAI_API_KEY=

# Modèle cloud a utiliser en fallback
# Anthropic : claude-3-haiku-20240307
# OpenAI    : gpt-3.5-turbo
LLM_CLOUD_MODEL=claude-3-haiku-20240307


# WHATSAPP

# Account SID Twilio (visible dans la console Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth Token Twilio (visible dans la console Twilio)
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Numéro WhatsApp Twilio Sandbox
# Format : whatsapp:+14155238886  (numero sandbox Twilio standard)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Numéro WhatsApp de destination (votre telephone)
# Format : whatsapp:+212XXXXXXXXX
TWILIO_WHATSAPP_TO=whatsapp:+212XXXXXXXXX

# Second contact d'astreinte (pour la commande ESCALATE)
TWILIO_WHATSAPP_ESCALATION=whatsapp:+212XXXXXXXXX


# GOOGLE SHEETS

# ID du Google Sheets (dans l'URL : /spreadsheets/d/SHEET_ID/edit)
GOOGLE_SHEETS_ID=votre_sheet_id_ici


# NGROK Tunnel public (optionnel, profil "demo")

# Token d'authentification ngrok
# Obtenir sur : https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=votre_token_ngrok_ici


# APPLICATION

# Timezone pour les timestamps (adapter si besoin)
TZ=Africa/Casablanca

# Fenetre glissante pour la detection ERROR_CASCADE (secondes)
# Si 2 erreurs arrivent dans cette fenêtre → transition vers ERROR_CASCADE
AFD_CASCADE_WINDOW_SECONDS=60

# Délai de reset temporel (secondes sans log → retour à NOMINAL)
AFD_RESET_TIMEOUT_SECONDS=300

