    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $json.body || $json;\n\nfunction detectFormat(log) {\n  if (typeof log === \"object\" && !Array.isArray(log)) {\n    return \"json\";\n  }\n\n  if (typeof log === \"string\") {\n    if (log.includes(\"GET\") && log.includes(\"HTTP\")) return \"apache\";\n    if (/^[A-Z][a-z]{2}\\s\\d{1,2}/.test(log)) return \"syslog\";\n    if (/\\d{4}-\\d{2}-\\d{2}/.test(log)) return \"plaintext\";\n  }\n\n  return \"unknown\";\n}\n\nreturn {\n  raw_log: input,\n  format_type: detectFormat(input)\n};"
      },
