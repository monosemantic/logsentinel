        "jsCode": "const log = $json.raw_log;\n\nconst match = typeof log === \"string\"\n  ? log.match(/(\\d+\\.\\d+\\.\\d+\\.\\d+).*?\\[(.*?)\\]\\s+\"(.*?)\"/)\n  : null;\n\nreturn {\n  source_id: \"apache\",\n  log_timestamp: match?.[2] || new Date().toISOString(),\n  raw_log: log,\n  message: match ? match[3] : log,\n  format_type: \"apache\"\n};"
