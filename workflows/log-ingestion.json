        "jsCode": "const log = $json.raw_log;\n\nconst match = typeof log === \"string\"\n  ? log.match(/^[A-Z][a-z]{2}\\s+\\d+\\s+\\d+:\\d+:\\d+\\s+\\S+\\s+(\\S+)\\[\\d+\\]:\\s+(.*)$/)\n  : null;\n\nreturn {\n  source_id: match?.[1] || \"unknown\",\n  log_timestamp: new Date().toISOString(),\n  raw_log: log,\n  message: match?.[2] || log,\n  format_type: \"syslog\"\n};"
      },
